<Window x:Class="Dk.PhpCompatibilityChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK PHP Version Compatibility Checker"
        Width="1120" Height="800" MinWidth="760" MinHeight="560"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource InkBrush}" UseLayoutRounding="True"
        Background="{DynamicResource CanvasBrush}"
        Icon="Assets/App.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#17223B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#4D5E79" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#D8DFEB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3847A7" />
        <SolidColorBrush x:Key="TintBrush" Color="#EEF0FF" />
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Metric" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TintBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OptionalText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionalFailureText" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="176" MaxHeight="270" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="92" />
            <RowDefinition Height="*" MinHeight="78" MaxHeight="150" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/App.ico" Width="32" Height="32" Margin="0,0,10,0" />
                <TextBlock Text="PHP 소스 호환성 검사" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource TintBrush}" CornerRadius="12" Padding="12,5"
                    MinWidth="132" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12,8" Margin="0,0,0,8">
            <ScrollViewer x:Name="InputSectionScrollViewer"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="검사할 폴더" Target="{Binding ElementName=SourceFolderTextBox}" VerticalAlignment="Center" Padding="0,4" />
                        <TextBox x:Name="SourceFolderTextBox" Grid.Column="1" Margin="0,0,8,8" Padding="5,4"
                                 Text="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditInputs}" ToolTip="{Binding SourceDirectory}"
                                 AutomationProperties.Name="검사할 PHP 소스 폴더" />
                        <Button x:Name="FolderBrowseButton" Grid.Column="2" Content="폴더 선택…" Margin="0,0,0,8" Padding="8,4"
                                IsEnabled="{Binding CanEditInputs}" Click="OnFolderBrowse" />
                        <Label Grid.Row="1" Content="목표 PHP 버전" Target="{Binding ElementName=TargetVersionComboBox}" VerticalAlignment="Center" Padding="0,4" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="TargetVersionComboBox" Width="150" Padding="5,3"
                                      ItemsSource="{Binding Targets}" DisplayMemberPath="Version"
                                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                      IsEditable="False" IsEnabled="{Binding CanEditInputs}"
                                      AutomationProperties.Name="목표 PHP 버전" />
                            <CheckBox x:Name="IncludeSubdirectoriesCheckBox" Content="하위 폴더 포함"
                                      IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEditInputs}" VerticalAlignment="Center" Margin="18,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                            <TextBlock x:Name="InputMessageTextBlock" Text="{Binding InputMessage}" Style="{StaticResource OptionalText}" />
                            <WrapPanel Margin="0,5,0,0">
                                <Button x:Name="ScanButton" Content="검사 실행" IsEnabled="False" MinWidth="108" Padding="12,5" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,12,0"
                                        Click="OnScan" ToolTip="선택한 폴더를 목표 PHP 버전으로 정적 검사합니다." />
                                <Button x:Name="ExportCsvButton" Content="CSV 저장…" IsEnabled="False" Padding="8,5" Margin="0,0,6,0" Click="OnExportCsv" />
                                <Button x:Name="ExportHtmlButton" Content="HTML 저장…" IsEnabled="False" Padding="8,5" Margin="0,0,10,0" Click="OnExportHtml" />
                                <TextBlock Text="검사 대상 소스는 변경하지 않습니다." VerticalAlignment="Center" TextWrapping="Wrap" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PackDownloadPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <WrapPanel>
                            <Button x:Name="DownloadPackButton" Content="검증된 엔진 팩 확인…" Click="OnDownloadPack"
                                    Padding="8,4" Margin="0,0,6,0" />
                            <Button x:Name="CancelPackDownloadButton" Content="중단" Click="OnCancelPackDownload"
                                    IsEnabled="False" Padding="8,4" />
                        </WrapPanel>
                        <TextBlock x:Name="PackDownloadStatus" Style="{StaticResource OptionalText}" />
                    </StackPanel>

                    <Expander x:Name="ExclusionSettingsExpander" Header="{Binding ExclusionSummary}" Margin="0,0,0,10">
                        <StackPanel>
                            <WrapPanel Margin="0,5,0,5">
                                <Button x:Name="ExcludeFolderButton" Content="폴더 추가…" Click="OnExcludedFolderBrowse"
                                        IsEnabled="{Binding CanEditExclusions}" Padding="8,3" Margin="0,0,6,0" />
                                <Button x:Name="ExcludeFileButton" Content="파일 추가…" Click="OnExcludedFileBrowse"
                                        IsEnabled="{Binding CanEditExclusions}" Padding="8,3" Margin="0,0,6,0" />
                                <Button x:Name="RemoveExclusionButton" Content="선택 항목 제거" Click="OnRemoveExclusion"
                                        IsEnabled="{Binding CanEditExclusions}" Padding="8,3" />
                            </WrapPanel>
                            <ListBox x:Name="ConfiguredExclusionsList" ItemsSource="{Binding ConfiguredExclusions}" MaxHeight="76"
                                     IsEnabled="{Binding CanEditExclusions}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="검사에서 제외하도록 지정한 경로" />
                            <TextBlock Text="지정한 폴더 내부와 지정 파일을 검사하지 않습니다. 검사 폴더를 바꾸면 목록이 초기화됩니다."
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
            <Border Style="{StaticResource Metric}">
                <StackPanel>
                    <TextBlock Text="선택 파일" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="SelectedFileCountTextBlock" Text="{Binding SelectedFileCountText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Metric}">
                <StackPanel>
                    <TextBlock Text="처리 파일" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="ProcessedFileCountTextBlock" Text="{Binding ProcessedFileCountText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Metric}">
                <StackPanel>
                    <TextBlock Text="오류 (ERROR)" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="ErrorCountTextBlock" Text="{Binding ErrorCountText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Metric}" Margin="0">
                <StackPanel>
                    <TextBlock Text="경고 (WARNING)" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="WarningCountTextBlock" Text="{Binding WarningCountText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="1">
            <DataGrid x:Name="IssuesGrid" ItemsSource="{Binding Issues}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="{StaticResource SurfaceBrush}" RowBackground="{StaticResource SurfaceBrush}"
                      AlternatingRowBackground="#F7F9FD" AlternationCount="2"
                      HorizontalGridLinesBrush="{StaticResource StrokeBrush}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource TintBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="파일" Width="2*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" ToolTip="{Binding FilePath}" Margin="8,6" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="줄" Binding="{Binding Line}" Width="60" />
                    <DataGridTextColumn Header="구분" Binding="{Binding Type}" Width="98" />
                    <DataGridTemplateColumn Header="문제 설명" Width="3*" MinWidth="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" ToolTip="{Binding Message}" Margin="8,6" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Panel}" Padding="12,5" Margin="0,8,0,0">
            <ScrollViewer MaxHeight="128" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SummaryTextBlock" Text="{Binding SummaryText}" Style="{StaticResource OptionalText}" Margin="0,3,0,0" />
                    <TextBox x:Name="FailureTextBlock" Text="{Binding FailureText, Mode=OneWay}" Style="{StaticResource OptionalFailureText}" Margin="0,3,0,0"
                             Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                             AutomationProperties.Name="검사 실패 상세 내용" ToolTip="오류 내용을 선택한 뒤 Ctrl+C로 복사할 수 있습니다." />
                    <Expander Header="제외된 경로" Margin="0,6,0,0">
                        <ListBox x:Name="ExcludedPathsList" ItemsSource="{Binding ExcludedPaths}" MaxHeight="58"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                    <TextBlock x:Name="LimitationsTextBlock" Text="{Binding LimitationsText}" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,3" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
