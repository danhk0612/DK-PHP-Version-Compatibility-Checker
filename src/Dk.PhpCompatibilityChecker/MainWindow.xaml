<Window x:Class="Dk.PhpCompatibilityChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK PHP Version Compatibility Checker"
        Width="960" Height="680" MinWidth="760" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="OptionalText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionalFailureText" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MaxHeight="270" />
            <RowDefinition Height="2*" MinHeight="100" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PHP 소스 호환성 검사" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusTextBlock" Grid.Column="1" Text="{Binding StatusText}"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>

        <ScrollViewer x:Name="InputSectionScrollViewer" Grid.Row="1" Margin="0,0,0,8"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="검사할 폴더" Target="{Binding ElementName=SourceFolderTextBox}" VerticalAlignment="Center" Padding="0,4" />
                    <TextBox x:Name="SourceFolderTextBox" Grid.Column="1" Margin="0,0,8,8" Padding="5,4"
                             Text="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditInputs}" ToolTip="{Binding SourceDirectory}"
                             AutomationProperties.Name="검사할 PHP 소스 폴더" />
                    <Button x:Name="FolderBrowseButton" Grid.Column="2" Content="폴더 선택…" Margin="0,0,0,8" Padding="8,4"
                            IsEnabled="{Binding CanEditInputs}" Click="OnFolderBrowse" />
                    <Label Grid.Row="1" Content="목표 PHP 버전" Target="{Binding ElementName=TargetVersionComboBox}" VerticalAlignment="Center" Padding="0,4" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="TargetVersionComboBox" Width="150" Padding="5,3"
                                  ItemsSource="{Binding Targets}" DisplayMemberPath="Version"
                                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                  IsEditable="False" IsEnabled="{Binding CanEditInputs}"
                                  AutomationProperties.Name="목표 PHP 버전" />
                        <CheckBox x:Name="IncludeSubdirectoriesCheckBox" Content="하위 폴더 포함"
                                  IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditInputs}" VerticalAlignment="Center" Margin="18,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBlock x:Name="InputMessageTextBlock" Text="{Binding InputMessage}" Style="{StaticResource OptionalText}" />
                        <DockPanel Margin="0,7,0,0" LastChildFill="True">
                            <Button x:Name="ScanButton" Content="검사 실행" IsEnabled="False" Width="108" Padding="12,5" Margin="0,0,12,0"
                                    Click="OnScan" ToolTip="선택한 폴더를 목표 PHP 버전으로 정적 검사합니다." />
                            <Button x:Name="ExportCsvButton" Content="CSV 저장…" IsEnabled="False" Padding="8,5" Margin="0,0,6,0" Click="OnExportCsv" />
                            <Button x:Name="ExportHtmlButton" Content="HTML 저장…" IsEnabled="False" Padding="8,5" Margin="0,0,10,0" Click="OnExportHtml" />
                            <TextBlock Text="검사 대상 소스는 변경하지 않습니다." VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <Expander x:Name="ExclusionSettingsExpander" Header="{Binding ExclusionSummary}" Margin="0,0,0,10">
                    <StackPanel>
                        <WrapPanel Margin="0,5,0,5">
                            <Button x:Name="ExcludeFolderButton" Content="폴더 추가…" Click="OnExcludedFolderBrowse"
                                    IsEnabled="{Binding CanEditExclusions}" Padding="8,3" Margin="0,0,6,0" />
                            <Button x:Name="ExcludeFileButton" Content="파일 추가…" Click="OnExcludedFileBrowse"
                                    IsEnabled="{Binding CanEditExclusions}" Padding="8,3" Margin="0,0,6,0" />
                            <Button x:Name="RemoveExclusionButton" Content="선택 항목 제거" Click="OnRemoveExclusion"
                                    IsEnabled="{Binding CanEditExclusions}" Padding="8,3" />
                        </WrapPanel>
                        <ListBox x:Name="ConfiguredExclusionsList" ItemsSource="{Binding ConfiguredExclusions}" Height="70"
                                 IsEnabled="{Binding CanEditExclusions}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="검사에서 제외하도록 지정한 경로" />
                        <TextBlock Text="지정한 폴더 내부와 지정 파일을 검사하지 않습니다. 검사 폴더를 바꾸면 목록이 초기화됩니다."
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Expander>

                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="9,7" Margin="0,0,0,10">
                    <UniformGrid Columns="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="선택 파일  " />
                            <TextBlock x:Name="SelectedFileCountTextBlock" Text="{Binding SelectedFileCountText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="처리 파일  " />
                            <TextBlock x:Name="ProcessedFileCountTextBlock" Text="{Binding ProcessedFileCountText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="오류 (ERROR)  " />
                            <TextBlock x:Name="ErrorCountTextBlock" Text="{Binding ErrorCountText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="경고 (WARNING)  " />
                            <TextBlock x:Name="WarningCountTextBlock" Text="{Binding WarningCountText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <ScrollViewer x:Name="StatusScrollViewer" MaxHeight="80"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,2">
                        <TextBlock x:Name="SummaryTextBlock" Text="{Binding SummaryText}" Style="{StaticResource OptionalText}" Margin="0,3,0,0" />
                        <TextBox x:Name="FailureTextBlock" Text="{Binding FailureText, Mode=OneWay}" Style="{StaticResource OptionalFailureText}" Margin="0,3,0,0"
                                 Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                 AutomationProperties.Name="검사 실패 상세 내용" ToolTip="오류 내용을 선택한 뒤 Ctrl+C로 복사할 수 있습니다." />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </ScrollViewer>

        <DataGrid x:Name="IssuesGrid" Grid.Row="2" ItemsSource="{Binding Issues}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="파일" Width="2*" MinWidth="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" ToolTip="{Binding FilePath}" Margin="5,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="줄" Binding="{Binding Line}" Width="52" />
                <DataGridTextColumn Header="구분" Binding="{Binding Type}" Width="90" />
                <DataGridTemplateColumn Header="문제 설명" Width="3*" MinWidth="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" ToolTip="{Binding Message}" Margin="5,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Expander Grid.Row="3" Header="제외된 경로" Margin="0,7,0,0">
            <ListBox x:Name="ExcludedPathsList" ItemsSource="{Binding ExcludedPaths}" MaxHeight="48"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" ToolTip="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>
        <ScrollViewer x:Name="LimitationsScrollViewer" Grid.Row="4" MaxHeight="76" Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="LimitationsTextBlock" Text="{Binding LimitationsText}" TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</Window>
